# SAFEFRAME 환경 변수 예시
# MVP 는 서버 없이 동작하므로 필수 값은 없습니다. 필요한 값만 .env.local 로 복사해서 사용하세요.

# 배포 도메인 (metadata / OG 절대경로 계산에 사용)
# - Vercel 에 배포하면 VERCEL_PROJECT_PRODUCTION_URL 로 자동 인식되므로 설정하지 않아도 됩니다.
# - 직접 지정할 때는 반드시 값을 채우세요. 빈 값으로 등록하면 안 됩니다.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# (선택) 플랫폼 프리셋을 원격에서 업데이트하고 싶을 때 사용할 Supabase 값
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
